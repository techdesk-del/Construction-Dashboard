# ==============================================================================
# CHAKRAMSAR FARMHOUSE EXECUTIVE DASHBOARD — ENVIRONMENT TEMPLATE
# Copy this file to `.env` or `.env.local` and fill in your actual credentials.
# ==============================================================================

# 1. MongoDB Database Connection
# Replace with your MongoDB Atlas or local MongoDB URI:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/construction_dashboard?retryWrites=true&w=majority

# 2. Authentication & JWT Security
JWT_SECRET=your_super_secret_jwt_key_here

# 3. Application Runtime & URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
